# ==============================================================================
# Environment Variables Configuration
# ==============================================================================

# 1. Base URL
# الدومين الأساسي للموقع، يستخدم في الخرائط والميتا داتا والروابط المطلقة
NEXT_PUBLIC_BASE_URL="https://naht-re.sa"

# ==============================================================================
# 2. Database (PostgreSQL - Supabase)
# ==============================================================================
# Connection string for Prisma
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL="postgres://postgres.xxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection string for Prisma migrations
# Supabase requires a direct connection (port 5432) for running migrations
DIRECT_URL="postgres://postgres.xxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ==============================================================================
# 3. Authentication (NextAuth)
# ==============================================================================
# The base URL of the application. Required for NextAuth to work in production.
NEXTAUTH_URL="https://naht-re.sa"

# A random string used to hash tokens, sign cookies and generate cryptographic keys.
# You can generate one using: `openssl rand -base64 32`
NEXTAUTH_SECRET="generate_a_strong_secret_key_here"

# ==============================================================================
# 4. Object Storage (Cloudflare R2 / AWS S3)
# ==============================================================================
# Access Key ID for the bucket
R2_ACCESS_KEY_ID="your_access_key_id"

# Secret Access Key for the bucket
R2_SECRET_ACCESS_KEY="your_secret_access_key"

# The S3 API endpoint provided by Cloudflare R2
# Example: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT="https://xxxxxx.r2.cloudflarestorage.com"

# The name of the bucket
R2_BUCKET_NAME="naht-uploads"

# The public custom domain connected to your R2 bucket to serve images/files
# Example: https://cdn.naht-re.sa
R2_PUBLIC_URL="https://cdn.naht-re.sa"
