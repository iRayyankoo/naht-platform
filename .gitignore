# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# ============================================================
# Security: Local-only files — NEVER commit these
# ============================================================
*.local
SECURITY_NOTES_LOCAL.md
مهم.txt
*مهم*.txt
private_local_*

# ============================================================
# Legacy Import — customer data must NEVER be committed
# ============================================================
*.xlsx
*.xls
scripts/legacy-import/dry-run-report.json
scripts/legacy-import/*.json
scripts/legacy-import/*.csv

_brand-input/
