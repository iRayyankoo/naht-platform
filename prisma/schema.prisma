// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MARKETING
  SALES
  VIEWER
}

enum NavigationLocation {
  HEADER
  FOOTER
  BOTH
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
  SUSPENDED
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role       @default(SALES)
  isActive      Boolean    @default(true)
  phone         String?
  jobTitle      String?
  departmentId  String?
  status        UserStatus @default(ACTIVE)

  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  assignedLeads Lead[]         @relation("AssignedLeads")
  leadNotes     LeadNote[]
  campaignLinks CampaignLink[]

  department Department? @relation(fields: [departmentId], references: [id])
  userRoles  UserRole[]

  // Phase 16 Task Management
  assignedTasks      Task[]            @relation("AssignedTasks")
  createdTasks       Task[]            @relation("CreatedTasks")
  requestedApprovals TaskApproval[]    @relation("RequestedApprovals")
  decidedApprovals   TaskApproval[]    @relation("DecidedApprovals")
  taskComments       TaskComment[]
  taskWatchers       TaskWatcher[]
  taskActivityLogs   TaskActivityLog[]

  // Phase 16 Work Projects Relations
  ownedWorkProjects              WorkProject[]            @relation("WorkProjectOwner")
  workProjectMemberships         WorkProjectMember[]      @relation("WorkProjectMemberships")
  workProjectActivityLogs        WorkProjectActivityLog[] @relation("WorkProjectActivityActor")
  uploadedWorkProjectAttachments WorkProjectAttachment[]  @relation("WorkProjectAttachmentsUploaded")
  uploadedTaskAttachments        TaskAttachment[]         @relation("TaskAttachmentsUploaded")
  designatedForTasks             Task[]                   @relation("DesignatedTaskApprover")

  // Phase 16 Work Projects Sections Relations
  managedWorkProjectSections    WorkProjectSection[]       @relation("WorkProjectSectionManager")
  workProjectSectionMemberships WorkProjectSectionMember[] @relation("WorkProjectSectionMemberships")

  userTaskPreference UserTaskPreference?

  // Phase O1: Organizational Foundation
  departmentMembers       DepartmentMember[]
  orgActivitiesAsActor    OrganizationActivityLog[] @relation("OrgActivityActor")
  orgActivitiesAsTarget   OrganizationActivityLog[] @relation("OrgActivityTarget")
  // Phase F1: Finance Relations
  financeSettingsUpdated  FinanceSettings[]         @relation("FinanceSettingsUpdater")
  financePeriodsClosed    FinanceFiscalPeriod[]     @relation("PeriodCloser")
  financeJournalsCreated  FinanceJournalEntry[]     @relation("JournalCreatedBy")
  financeJournalsReviewed FinanceJournalEntry[]     @relation("JournalReviewedBy")
  financeJournalsApproved FinanceJournalEntry[]     @relation("JournalApprovedBy")
  financeJournalsPosted   FinanceJournalEntry[]     @relation("JournalPostedBy")
  financeJournalReversals FinanceJournalReversal[]  @relation("ReversalActor")
  financeActivityLogs     FinanceActivityLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id           String  @id @default(cuid())
  slug         String  @unique
  name         String
  type         String
  city         String
  neighborhood String
  status       String  @default("AVAILABLE") // AVAILABLE, SOLD, COMING_SOON
  shortDesc    String?
  fullDesc     String?
  mainImage    String?
  isFeatured   Boolean @default(false)
  isVisible    Boolean @default(true)

  // Phase 14 additions
  area            Float?
  price           Float?
  rooms           Int?
  baths           Int?
  progressPercent Int?
  progressLabel   String?
  googleMapsUrl   String?
  locationText    String?
  pdfUrl          String?

  // Interactive Map Fields (Batch 15 Revision)
  showOnHomeMap Boolean @default(false)
  mapLat        Float?
  mapLng        Float?
  mapX          Float? // Deprecated but kept for image map mode
  mapY          Float? // Deprecated but kept for image map mode

  // Phase 6E additions
  planImage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units         Unit[]
  models        ProjectModel[]
  leads         Lead[]
  campaignLinks CampaignLink[]
  clickEvents   ClickEvent[]
  features      ProjectFeature[]
  warranties    ProjectWarranty[]
  galleryImages ProjectGalleryImage[]
}

model ProjectFeature {
  id        String  @id @default(cuid())
  projectId String
  title     String
  desc      String?
  icon      String?
  order     Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectWarranty {
  id        String  @id @default(cuid())
  projectId String
  title     String
  desc      String?
  duration  String?
  order     Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectGalleryImage {
  id        String  @id @default(cuid())
  projectId String
  url       String
  alt       String?
  order     Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectModel {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  code        String?
  description String?
  planImage   String?
  area        String?
  rooms       Int?
  baths       Int?
  status      String?
  sortOrder   Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  units   Unit[]
}

model Unit {
  id        String  @id @default(cuid())
  projectId String
  unitNum   String
  type      String
  area      Float
  rooms     Int
  baths     Int
  price     Float   @default(0)
  status    String  @default("AVAILABLE") // AVAILABLE, SOLD, RESERVED
  isVisible Boolean @default(true)

  // Phase 6E additions
  modelId       String?
  floor         String?
  facade        String?
  unitPlanImage String?
  sortOrder     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  model   ProjectModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)
}

model Lead {
  id             String  @id @default(cuid())
  name           String
  phone          String
  email          String?
  projectId      String?
  formType       String // GENERAL, PROJECT_SPECIFIC
  source         String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  landingPageUrl String?
  referrer       String?
  deviceType     String?
  platform       String?
  message        String?

  // Custom Fields for Sales
  budget                 String?
  propertyType           String? // شقة / فيلا / دور / تاون هاوس / غير محدد
  preferredContactMethod String? // واتساب / اتصال / بريد إلكتروني
  preferredContactTime   String?
  city                   String?
  district               String?
  consent                Boolean @default(true)
  leadTemperature        String? // Hot / Warm / Cold

  assignedToId String?
  status       String  @default("NEW") // جديد, تم التواصل, لم يتم الرد, مهتم, تم إرسال التفاصيل, تم جدولة زيارة, تمت الزيارة, تفاوض, تم البيع, خاسر, غير مؤهل, مكرر, مؤجل

  // Phase 4 additions
  leadType          String  @default("GENERAL") // GENERAL, CONTACT_US, REAL_ESTATE_OPPORTUNITY, PROJECT_INTEREST
  opportunityType   String?
  propertyLocation  String?
  landArea          Float?
  propertyOwnership String?

  followUpDate  DateTime?
  internalNotes String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project    Project?   @relation(fields: [projectId], references: [id])
  assignedTo User?      @relation("AssignedLeads", fields: [assignedToId], references: [id])
  notes      LeadNote[]
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  userId    String
  noteType  String // تم إرسال واتساب, تم إرسال تفاصيل المشروع, تم تحديد موعد زيارة, تمت الزيارة, العميل طلب التواصل لاحقًا, ملاحظة داخلية
  content   String?
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

model CampaignLink {
  id             String  @id @default(cuid())
  shortCode      String? @unique
  campaignName   String
  destinationUrl String
  platform       String
  utmSource      String
  utmMedium      String
  utmCampaign    String
  utmContent     String?
  utmTerm        String?
  finalUrl       String
  notes          String?

  projectId       String?
  createdByUserId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project?     @relation(fields: [projectId], references: [id])
  createdBy   User         @relation(fields: [createdByUserId], references: [id])
  clickEvents ClickEvent[]
}

model ClickEvent {
  id            String  @id @default(cuid())
  actionType    String // WHATSAPP, CALL
  targetContact String?
  pageUrl       String

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  deviceType  String?
  userAgent   String?
  referrer    String?

  sessionId String?
  visitorId String?

  projectId      String?
  campaignLinkId String?

  createdAt DateTime @default(now())

  project      Project?      @relation(fields: [projectId], references: [id])
  campaignLink CampaignLink? @relation(fields: [campaignLinkId], references: [id])
}

model SiteSettings {
  id String @id @default("global")

  siteName   String  @default("شركة نحت الأصول العقارية")
  logoUrl    String?
  faviconUrl String?

  contactEmail   String?
  contactPhone   String?
  whatsappNumber String?
  address        String?
  googleMapsUrl  String?
  workingHours   String?

  footerText    String?
  copyrightText String?

  // Phase 6 SEO Defaults
  defaultSeoTitle       String?
  defaultSeoDescription String?
  defaultOgImage        String?
  canonicalBaseUrl      String?
  defaultRobotsIndex    Boolean @default(true)

  // Batch 9 Brand Identity
  logoDarkUrl    String?
  brandTagline   String?
  primaryColor   String?
  secondaryColor String?
  accentColor    String?
  darkBgColor    String?
  buttonColor    String?
  textColor      String?
  borderColor    String?

  // Batch 10 Footer Management
  footerCompanyName  String?
  footerDescription  String?
  footerLogoUrl      String?
  showFooterLogo     Boolean @default(true)
  showImportantLinks Boolean @default(true)
  showContactInfo    Boolean @default(true)
  showEmployeePortal Boolean @default(true)
  showSocialLinks    Boolean @default(true)

  // Batch 12 Header
  headerCtaText String? @default("بوابة الشركاء")
  headerCtaUrl  String? @default("/auth/login")

  updatedAt DateTime @updatedAt
}

model FooterLink {
  id         String   @id @default(cuid())
  label      String
  url        String
  isExternal Boolean  @default(false)
  isVisible  Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TrackingSettings {
  id String @id @default("global")

  gtmId            String?
  isGtmEnabled     Boolean @default(false)
  ga4MeasurementId String?
  isGa4Enabled     Boolean @default(false)

  googleAdsId              String?
  googleAdsConversionLabel String?
  isGoogleAdsEnabled       Boolean @default(false)

  metaPixelId            String?
  isMetaPixelEnabled     Boolean @default(false)
  tiktokPixelId          String?
  isTiktokPixelEnabled   Boolean @default(false)
  snapchatPixelId        String?
  isSnapchatPixelEnabled Boolean @default(false)
  linkedinPartnerId      String?
  isLinkedinEnabled      Boolean @default(false)
  xPixelId               String?
  isXPixelEnabled        Boolean @default(false)

  customHeadScript       String?
  customBodyStartScript  String?
  customBodyEndScript    String?
  isCustomScriptsEnabled Boolean @default(false)

  updatedAt DateTime @updatedAt
}

model SocialLink {
  id           String   @id @default(cuid())
  platformName String
  url          String
  icon         String?
  order        Int      @default(0)
  isVisible    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HomePageContent {
  id String @id @default("global")

  heroDisplayMode     String  @default("classic")
  heroTitle           String  @default("نحت الأصول العقارية")
  heroSubtitle        String  @default("نبني مستقبل الإسكان بأعلى معايير الجودة")
  heroBackgroundImage String?
  ctaButtonText       String  @default("تصفح مشاريعنا")
  ctaButtonUrl        String  @default("/projects")

  statsTitle String?
  stat1Label String?
  stat1Value String?
  stat2Label String?
  stat2Value String?
  stat3Label String?
  stat3Value String?

  whyNahtTitle       String?
  whyNahtDescription String?

  aboutBriefTitle String?
  aboutBriefText  String?
  aboutBriefImage String?

  // Batch 12 NahtStandard
  nahtStandardTitle       String? @default("The Naht Standard")
  nahtStandardSubtitle    String? @default("نرتقي بمفهوم التطوير العقاري.")
  nahtStandardDescription String? @default("نلتزم في \"نحت\" بأعلى معايير الجودة العالمية، حيث ندمج بين التصميم المعماري العبقري، واستدامة التنفيذ، واختيار أميز المواقع لنخلق أصولاً عقارية تتوارثها الأجيال.")

  nahtFeature1Title String? @default("مواقع استراتيجية")
  nahtFeature1Desc  String? @default("انتقاء دقيق لأرقى الأحياء وأكثرها نمواً لضمان جودة الحياة والعائد الاستثماري.")
  nahtFeature2Title String? @default("جودة البناء")
  nahtFeature2Desc  String? @default("استخدام أفضل المواد وتطبيق أدق معايير الكود السعودي للبناء.")
  nahtFeature3Title String? @default("تصاميم استثنائية")
  nahtFeature3Desc  String? @default("واجهات عصرية وتقسيمات داخلية ذكية تلبي تطلعات العائلة العصرية.")
  nahtFeature4Title String? @default("ضمانات ممتدة")
  nahtFeature4Desc  String? @default("نقدم ضمانات حقيقية تمتد لسنوات لحماية استثمارك وراحتك.")

  // Phase 15 Map Section
  showMapSection     Boolean @default(true)
  mapSectionTitle    String?
  mapSectionDesc     String?
  mapMode            String? @default("geographic") // geographic | image
  mapCenterLat       Float?  @default(24.7136)
  mapCenterLng       Float?  @default(46.6753)
  mapZoom            Int?    @default(5)
  mapBackgroundImage String?

  // Pin Settings (Batch 15)
  pinColorAvailable         String? @default("#B5B693")
  pinColorSold              String? @default("#4E4949")
  pinColorComingSoon        String? @default("#C5B59C")
  pinColorUnderConstruction String? @default("#A6937C")
  pinColorDefault           String? @default("#A6937C")
  pinLogoUrl                String?
  pinLogoSize               Int?    @default(32)

  // Map Style Settings (Batch 15)
  mapTileStyle      String? @default("light") // light, warm, muted, grayscale, dark
  mapTileBrightness Int?    @default(100)
  mapTileContrast   Int?    @default(100)
  mapTileSaturation Int?    @default(100)
  mapTileHue        Int?    @default(0)
  mapTileGrayscale  Int?    @default(0)

  updatedAt DateTime @updatedAt
}

// Batch 12 Projects Page Content
model ProjectsPageContent {
  id String @id @default("global")

  title          String  @default("مشاريعنا العقارية")
  description    String? @default("اكتشف أحدث مشاريع شركة نحت الأصول العقارية في أرقى أحياء المملكة.")
  emptyStateText String? @default("لا توجد مشاريع حالياً. نعمل على إضافة مشاريع جديدة قريباً.")

  seoTitle       String?
  seoDescription String?

  updatedAt DateTime @updatedAt
}

model AboutPageContent {
  id String @id @default("global")

  title            String  @default("من نحن")
  shortDescription String?
  fullDescription  String?

  vision  String?
  mission String?
  values  String?

  mediaUrl     String?
  companyStats String?

  seoTitle       String?
  seoDescription String?

  updatedAt DateTime @updatedAt
}

model Service {
  id              String  @id @default(cuid())
  slug            String? @unique
  title           String
  description     String
  fullDescription String?
  icon            String?
  image           String?
  order           Int     @default(0)
  isVisible       Boolean @default(true)

  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  category  String?
  question  String
  answer    String
  order     Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MaintenanceRequest {
  id            String   @id @default(cuid())
  fullName      String
  phone         String
  email         String?
  projectOrUnit String?
  issueType     String
  description   String
  attachmentUrl String?
  status        String   @default("NEW") // NEW, IN_PROGRESS, RESOLVED, CANCELLED
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model VendorApplication {
  id               String   @id @default(cuid())
  companyName      String
  contactPerson    String
  phone            String
  email            String
  vendorType       String
  specialty        String
  commercialRecord String?
  city             String?
  companyProfile   String?
  status           String   @default("NEW") // NEW, IN_PROGRESS, RESOLVED, CANCELLED
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model JobApplication {
  id              String   @id @default(cuid())
  fullName        String
  phone           String
  email           String
  position        String
  experienceYears Int?
  city            String?
  linkedInUrl     String?
  resumeUrl       String
  status          String   @default("NEW") // NEW, IN_PROGRESS, RESOLVED, CANCELLED
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ContactPageContent {
  id String @id @default("global")

  title            String  @default("تواصل معنا")
  description      String?
  formTitle        String  @default("أرسل رسالتك")
  submitButtonText String  @default("إرسال الرسالة")
  helperText       String?
  heroImage        String?

  seoTitle       String?
  seoDescription String?

  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------
// Phase 6E-10 CMS Site Map Models
// -----------------------------------------------------

model SitePage {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  parentId       String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  showInNavbar   Boolean  @default(false)
  showInFooter   Boolean  @default(false)
  seoTitle       String?
  seoDescription String?
  ctaLabel       String?
  ctaHref        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent   SitePage?  @relation("PageHierarchy", fields: [parentId], references: [id])
  children SitePage[] @relation("PageHierarchy")
}

model NavigationItem {
  id           String             @id @default(cuid())
  label        String
  href         String
  location     NavigationLocation @default(HEADER)
  sortOrder    Int                @default(0)
  isActive     Boolean            @default(true)
  openInNewTab Boolean            @default(false)
  parentId     String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  parent   NavigationItem?  @relation("NavHierarchy", fields: [parentId], references: [id])
  children NavigationItem[] @relation("NavHierarchy")
}

model UserFlowSection {
  id         String   @id @default(cuid())
  pageKey    String   @default("home")
  sectionKey String
  adminLabel String
  title      String?
  subtitle   String?
  ctaLabel   String?
  ctaHref    String?
  sortOrder  Int      @default(0)
  isVisible  Boolean  @default(true)
  isLocked   Boolean  @default(false)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([pageKey, sectionKey])
}

// -----------------------------------------------------
// Phase 6E-10 Org Structure & RBAC Models
// -----------------------------------------------------

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  parentId    String?
  managerId   String? // References User.id
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children Department[] @relation("DeptHierarchy")
  users    User[]

  // Phase O1: Organizational Foundation
  members         DepartmentMember[]
  orgActivityLogs OrganizationActivityLog[] @relation("OrgActivityDept")

  // Phase F1: Finance Relations
  financeCostCenters FinanceCostCenter[]
}

model AppRole {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String   @id @default(cuid())
  module      String
  action      String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model RolePermission {
  id           String          @id @default(cuid())
  roleId       String
  permissionId String
  scope        PermissionScope @default(COMPANY)
  createdAt    DateTime        @default(now())

  role       AppRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

// -----------------------------------------------------
// Phase 6E-10L Security & Audit Models
// -----------------------------------------------------

model AuditLog {
  id           String   @id @default(cuid())
  action       String
  actorUserId  String?
  targetUserId String?
  entityType   String?
  entityId     String?
  route        String?
  method       String?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([action])
  @@index([actorUserId])
  @@index([targetUserId])
  @@index([createdAt])
}

// -----------------------------------------------------
// Phase 16 Task Management
// -----------------------------------------------------

model Task {
  id               String    @id @default(cuid())
  title            String
  description      String?
  assignedToId     String?
  relatedType      String? // e.g., "PROJECT", "LEAD"
  relatedId        String?
  priority         String // LOW, MEDIUM, HIGH
  taskStatus       String    @default("TODO") // TODO, IN_PROGRESS, DONE, CANCELLED
  approvalStatus   String    @default("NOT_REQUIRED") // NOT_REQUIRED, PENDING, APPROVED, REJECTED
  requiresApproval Boolean   @default(false)
  approvalRound    Int       @default(0)
  dueDate          DateTime?
  createdById      String
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workProjectId        String?
  designatedApproverId String?
  workProjectSectionId String?
  plannedStartAt       DateTime?

  assignedTo         User?               @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy          User                @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Restrict)
  workProject        WorkProject?        @relation(fields: [workProjectId], references: [id], onDelete: SetNull)
  workProjectSection WorkProjectSection? @relation(fields: [workProjectSectionId], references: [id], onDelete: SetNull)
  designatedApprover User?               @relation("DesignatedTaskApprover", fields: [designatedApproverId], references: [id], onDelete: SetNull)

  approvals    TaskApproval[]
  comments     TaskComment[]
  watchers     TaskWatcher[]
  activityLogs TaskActivityLog[]
  attachments  TaskAttachment[]

  @@index([taskStatus])
  @@index([approvalStatus])
  @@index([assignedToId])
  @@index([dueDate])
  @@index([workProjectId])
  @@index([designatedApproverId])
  @@index([workProjectSectionId])
  @@index([plannedStartAt])
}

model TaskApproval {
  id              String    @id @default(cuid())
  taskId          String
  approvalRound   Int
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  requestedById   String
  requestedAt     DateTime  @default(now())
  approverId      String?
  decisionComment String?
  decidedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  task        Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("RequestedApprovals", fields: [requestedById], references: [id], onDelete: Restrict)
  approver    User? @relation("DecidedApprovals", fields: [approverId], references: [id], onDelete: SetNull)

  @@unique([taskId, approvalRound])
  @@index([status])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TaskWatcher {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

model TaskActivityLog {
  id         String   @id @default(cuid())
  taskId     String
  actorId    String?
  eventType  String // CREATED, UPDATED, ASSIGNED, PRIORITY_CHANGED, IN_PROGRESS, COMMENT_ADDED, SUBMITTED_FOR_APPROVAL, APPROVED, REJECTED, RESUBMITTED, COMPLETED, CANCELLED
  fromStatus String?
  toStatus   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

// -----------------------------------------------------
// Phase 16 Work Projects
// -----------------------------------------------------

enum WorkProjectStatus {
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum WorkProjectMemberRole {
  OWNER
  MANAGER
  MEMBER
  VIEWER
}

enum AttachmentStatus {
  PENDING
  READY
  DELETING
  FAILED
}

model WorkProject {
  id          String            @id @default(cuid())
  name        String
  description String?           @db.Text
  status      WorkProjectStatus @default(PLANNING)
  startDate   DateTime?
  endDate     DateTime?
  ownerId     String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  owner        User                     @relation("WorkProjectOwner", fields: [ownerId], references: [id])
  members      WorkProjectMember[]
  tasks        Task[]
  attachments  WorkProjectAttachment[]
  activityLogs WorkProjectActivityLog[]
  sections     WorkProjectSection[]

  // Phase F1: Finance Relations
  financeCostCenters FinanceCostCenter[]

  @@index([ownerId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model WorkProjectMember {
  id            String                @id @default(cuid())
  workProjectId String
  userId        String
  role          WorkProjectMemberRole @default(MEMBER)
  createdAt     DateTime              @default(now())

  workProject WorkProject @relation(fields: [workProjectId], references: [id], onDelete: Cascade)
  user        User        @relation("WorkProjectMemberships", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([workProjectId, userId])
  @@index([userId])
  @@index([workProjectId])
}

model WorkProjectActivityLog {
  id            String   @id @default(cuid())
  workProjectId String
  actorId       String?
  eventType     String
  metadata      Json?
  createdAt     DateTime @default(now())

  workProject WorkProject @relation(fields: [workProjectId], references: [id], onDelete: Restrict)
  actor       User?       @relation("WorkProjectActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workProjectId, createdAt])
  @@index([actorId])
}

model WorkProjectAttachment {
  id               String           @id @default(cuid())
  workProjectId    String
  originalFileName String
  storageKey       String           @unique
  bucketName       String
  mimeType         String
  fileSize         Int
  checksum         String?
  status           AttachmentStatus @default(PENDING)
  uploadedById     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  workProject WorkProject @relation(fields: [workProjectId], references: [id], onDelete: Restrict)
  uploadedBy  User?       @relation("WorkProjectAttachmentsUploaded", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([workProjectId, createdAt])
  @@index([status])
  @@index([uploadedById])
}

model TaskAttachment {
  id               String           @id @default(cuid())
  taskId           String
  originalFileName String
  storageKey       String           @unique
  bucketName       String
  mimeType         String
  fileSize         Int
  checksum         String?
  status           AttachmentStatus @default(PENDING)
  uploadedById     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  task       Task  @relation(fields: [taskId], references: [id], onDelete: Restrict)
  uploadedBy User? @relation("TaskAttachmentsUploaded", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([status])
  @@index([uploadedById])
}

enum WorkProjectSectionStatus {
  ACTIVE
  ARCHIVED
}

model WorkProjectSection {
  id             String                   @id @default(cuid())
  workProjectId  String
  name           String
  normalizedName String
  description    String?
  managerId      String?
  color          String?                  @default("#3B82F6")
  status         WorkProjectSectionStatus @default(ACTIVE)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  workProject WorkProject                @relation(fields: [workProjectId], references: [id])
  manager     User?                      @relation("WorkProjectSectionManager", fields: [managerId], references: [id])
  tasks       Task[]
  members     WorkProjectSectionMember[]

  @@unique([workProjectId, normalizedName])
  @@index([workProjectId])
  @@index([managerId])
  @@index([status])
}

model WorkProjectSectionMember {
  id        String   @id @default(cuid())
  sectionId String
  userId    String
  createdAt DateTime @default(now())

  section WorkProjectSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  user    User               @relation("WorkProjectSectionMemberships", fields: [userId], references: [id])

  @@unique([sectionId, userId])
  @@index([userId])
  @@index([sectionId])
}

enum TaskViewMode {
  TABLE
  GANTT
  TIMELINE
  CALENDAR
  KANBAN
  CARDS
}

model UserTaskPreference {
  id              String       @id @default(cuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultViewMode TaskViewMode @default(KANBAN)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("user_task_preferences")
}

// -----------------------------------------------------
// Phase O1: Organizational Foundation
// -----------------------------------------------------

enum DepartmentMembershipStatus {
  ACTIVE
  TRANSFERRED
  INACTIVE
}

enum DepartmentMembershipRole {
  MEMBER
  OBSERVER
}

enum DepartmentMembershipSource {
  MANUAL
  LEGACY_MIGRATION
  HR_SYNC
}

enum PermissionScope {
  SELF
  ASSIGNED
  DEPARTMENT
  COMPANY
}

model DepartmentMember {
  id           String @id @default(cuid())
  departmentId String
  userId       String

  isPrimary      Boolean                    @default(false)
  membershipRole DepartmentMembershipRole   @default(MEMBER)
  status         DepartmentMembershipStatus @default(ACTIVE)
  source         DepartmentMembershipSource @default(MANUAL)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([departmentId])
  @@index([userId])
  @@index([status])
  @@index([effectiveFrom])
  @@index([effectiveTo])
  @@map("department_members")
}

enum OrganizationActionType {
  MEMBER_ASSIGNED
  MEMBER_TRANSFERRED
  MEMBER_ENDED
  PRIMARY_DEPARTMENT_CHANGED
  MANAGER_ASSIGNED
  MEMBER_ROLE_CHANGED
  MANAGER_REMOVED
  DEPARTMENT_ARCHIVED
  DEPARTMENT_RESTORED
}

model OrganizationActivityLog {
  id           String                 @id @default(cuid())
  actorId      String
  action       OrganizationActionType
  departmentId String?
  targetUserId String?
  oldValues    Json?
  newValues    Json?
  reason       String?
  createdAt    DateTime               @default(now())

  actor      User?       @relation("OrgActivityActor", fields: [actorId], references: [id], onDelete: Restrict)
  department Department? @relation("OrgActivityDept", fields: [departmentId], references: [id], onDelete: Restrict)
  targetUser User?       @relation("OrgActivityTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([targetUserId])
  @@index([departmentId])
  @@index([createdAt])
  @@map("organization_activity_logs")
}

// -----------------------------------------------------
// Phase F1: Financial Base & General Ledger
// -----------------------------------------------------

enum FinancePeriodStatus {
  OPEN
  FROZEN
  CLOSED
}

enum FinanceJournalStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  POSTED
  VOIDED
}

enum FinanceJournalSource {
  MANUAL
  REVERSAL
}

enum FinanceAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum FinanceNormalBalance {
  DEBIT
  CREDIT
}

enum FinanceCostCenterType {
  DEPARTMENT
  PROJECT
  OTHER
}

enum FinanceActivityAction {
  JOURNAL_CREATED
  JOURNAL_REVIEWED
  JOURNAL_APPROVED
  JOURNAL_POSTED
  JOURNAL_REVERSED
  JOURNAL_VOIDED
  PERIOD_OPENED
  PERIOD_CLOSED
  SETTINGS_UPDATED
  ACCOUNT_CREATED
  ACCOUNT_UPDATED
  ACCOUNT_DEACTIVATED
  ACCOUNT_REACTIVATED
  PERIOD_CREATED
  YEAR_CREATED
  LEDGER_CREATED
  LEDGER_UPDATED
  LEDGER_DEACTIVATED
  LEDGER_REACTIVATED
}

enum FinanceRoundingPolicy {
  HALF_EVEN
  HALF_UP
  HALF_DOWN
}

enum FinanceDocumentType {
  JOURNAL_ENTRY
  VENDOR_INVOICE
  PAYMENT
}

model FinanceLedger {
  id        String   @id @default(cuid())
  code      String   @unique
  nameAr    String
  nameEn    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings   FinanceSettings?
  years      FinanceFiscalYear[]
  accounts   FinanceAccount[]
  costCenter FinanceCostCenter[]
  sequences  FinanceDocumentSequence[]
  journals   FinanceJournalEntry[]
}

model FinanceCurrency {
  id        String   @id @default(cuid())
  code      String   @unique // ISO e.g., "SAR", "USD"
  nameAr    String
  nameEn    String
  decimals  Int      @default(2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings FinanceSettings[]
  journals FinanceJournalEntry[]
}

model FinanceSettings {
  id               String                @id @default(cuid())
  ledgerId         String                @unique
  baseCurrencyId   String
  timezone         String                @default("Asia/Riyadh")
  roundingPolicy   FinanceRoundingPolicy @default(HALF_EVEN)
  companyTaxNumber String?
  isTaxEnabled     Boolean               @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String

  ledger       FinanceLedger   @relation(fields: [ledgerId], references: [id], onDelete: Restrict)
  baseCurrency FinanceCurrency @relation(fields: [baseCurrencyId], references: [id], onDelete: Restrict)
  updatedBy    User            @relation("FinanceSettingsUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
}

model FinanceDocumentSequence {
  id           String              @id @default(cuid())
  ledgerId     String
  fiscalYearId String?
  documentType FinanceDocumentType
  prefix       String
  nextNumber   BigInt              @default(1)
  padding      Int                 @default(6)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  ledger     FinanceLedger      @relation(fields: [ledgerId], references: [id], onDelete: Restrict)
  fiscalYear FinanceFiscalYear? @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)

  @@unique([ledgerId, fiscalYearId, documentType])
}

model FinanceFiscalYear {
  id        String   @id @default(cuid())
  ledgerId  String
  year      Int
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledger    FinanceLedger             @relation(fields: [ledgerId], references: [id], onDelete: Restrict)
  periods   FinanceFiscalPeriod[]
  sequences FinanceDocumentSequence[]

  @@unique([ledgerId, year])
}

model FinanceFiscalPeriod {
  id           String              @id @default(cuid())
  fiscalYearId String
  periodNumber Int
  periodName   String // e.g., "Jan 2026"
  startDate    DateTime            @db.Date
  endDate      DateTime            @db.Date
  status       FinancePeriodStatus @default(OPEN)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  closedAt   DateTime?
  closedById String?

  fiscalYear FinanceFiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  closedBy   User?                 @relation("PeriodCloser", fields: [closedById], references: [id], onDelete: Restrict)
  journals   FinanceJournalEntry[]

  @@unique([fiscalYearId, periodNumber])
}

model FinanceAccount {
  id               String               @id @default(cuid())
  ledgerId         String
  code             String
  nameAr           String
  nameEn           String
  type             FinanceAccountType
  normalBalance    FinanceNormalBalance
  parentId         String?
  isPostingAllowed Boolean              @default(true)
  isActive         Boolean              @default(true)
  description      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledger   FinanceLedger        @relation(fields: [ledgerId], references: [id], onDelete: Restrict)
  parent   FinanceAccount?      @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children FinanceAccount[]     @relation("AccountHierarchy")
  lines    FinanceJournalLine[]

  @@unique([ledgerId, code])
  @@index([type])
  @@index([parentId])
}

model FinanceCostCenter {
  id           String                @id @default(cuid())
  ledgerId     String
  code         String
  type         FinanceCostCenterType
  nameAr       String
  nameEn       String
  isActive     Boolean               @default(true)
  departmentId String?
  projectId    String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  ledger     FinanceLedger        @relation(fields: [ledgerId], references: [id], onDelete: Restrict)
  department Department?          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  project    WorkProject?         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  lines      FinanceJournalLine[]

  @@unique([ledgerId, code])
}

model FinanceJournalEntry {
  id             String               @id @default(cuid())
  ledgerId       String
  fiscalPeriodId String
  entryNumber    String? // Assigned dynamically on POSTED by atomic function
  entryDate      DateTime             @db.Date
  description    String
  reference      String?
  sourceModule   FinanceJournalSource @default(MANUAL)
  status         FinanceJournalStatus @default(DRAFT)

  currencyId     String
  exchangeRate   Decimal @default(1) @db.Decimal(20, 10)
  idempotencyKey String?

  createdById     String
  reviewedById    String?
  approvedById    String?
  postedById      String?
  rejectionReason String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  reviewedAt DateTime?
  approvedAt DateTime?
  postedAt   DateTime?

  fiscalPeriod FinanceFiscalPeriod @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)
  currency     FinanceCurrency     @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  createdBy    User                @relation("JournalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy   User?               @relation("JournalReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  approvedBy   User?               @relation("JournalApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  postedBy     User?               @relation("JournalPostedBy", fields: [postedById], references: [id], onDelete: Restrict)

  lines FinanceJournalLine[]

  originalReversal FinanceJournalReversal? @relation("OriginalJournalEntry")
  reversalEntry    FinanceJournalReversal? @relation("ReversalJournalEntry")
  ledger           FinanceLedger           @relation(fields: [ledgerId], references: [id], onDelete: Restrict)

  @@unique([ledgerId, entryNumber])
  @@unique([ledgerId, idempotencyKey])
  @@index([status])
  @@index([entryDate])
}

model FinanceJournalLine {
  id             String  @id @default(cuid())
  journalEntryId String
  lineNumber     Int
  accountId      String
  costCenterId   String?
  description    String?

  debitAmount      Decimal @default(0) @db.Decimal(19, 4)
  creditAmount     Decimal @default(0) @db.Decimal(19, 4)
  baseDebitAmount  Decimal @default(0) @db.Decimal(19, 4)
  baseCreditAmount Decimal @default(0) @db.Decimal(19, 4)

  journalEntry FinanceJournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  account      FinanceAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  costCenter   FinanceCostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: Restrict)

  @@unique([journalEntryId, lineNumber])
  @@index([accountId])
}

model FinanceJournalReversal {
  id              String   @id @default(cuid())
  originalEntryId String   @unique
  reversalEntryId String   @unique
  reason          String
  actorId         String
  createdAt       DateTime @default(now())

  originalEntry FinanceJournalEntry @relation("OriginalJournalEntry", fields: [originalEntryId], references: [id], onDelete: Restrict)
  reversalEntry FinanceJournalEntry @relation("ReversalJournalEntry", fields: [reversalEntryId], references: [id], onDelete: Restrict)
  actor         User                @relation("ReversalActor", fields: [actorId], references: [id], onDelete: Restrict)
}

model FinanceActivityLog {
  id         String                @id @default(cuid())
  actorId    String
  action     FinanceActivityAction
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime              @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([createdAt])
}
